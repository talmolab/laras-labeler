diff --git a/tests/test_reviewed_frames.py b/tests/test_reviewed_frames.py
new file mode 100644
index 0000000..d0e9996
--- /dev/null
+++ b/tests/test_reviewed_frames.py
@@ -0,0 +1,209 @@
+"""Reviewed-frames-only fine-tuning (`finetune.py prepare --reviewed`).
+
+A frame nobody reviewed must count as neither positive nor negative. These tests pin the
+places that make that true. They cover what `prepare` stages, the per-frame mask
+`create_labels` builds, the -1 label a window carries for an unreviewed frame and the loss
+that leaves it out. With every frame reviewed, or no --reviewed at all, nothing may change.
+"""
+import os
+import subprocess
+import sys
+
+import numpy as np
+import pandas as pd
+import torch
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+LAB, ACTION = "LyricalHare", "approach"
+BOUT = (100, 160)                      # the one positive bout in each synthetic video
+REVIEWED = [(60, 100), (160, 260)]     # reviewed negatives around it (video 0 only)
+
+
+def _run(args, expect=0):
+    res = subprocess.run([sys.executable, os.path.join(REPO, "finetune.py"), *args],
+                         capture_output=True, text=True, cwd=REPO, timeout=900)
+    assert res.returncode == expect, f"{res.stdout[-3000:]}\n{res.stderr[-3000:]}"
+    return res.stdout + res.stderr
+
+
+def _prepare(track_dir, out, reviewed=True):
+    files = sorted(p.name for p in track_dir.glob("*.parquet"))
+    span = dict(agent="mouse2", target="mouse1", action=ACTION)
+    bouts = out / "bouts.csv"
+    pd.DataFrame([dict(file=f, start_frame=BOUT[0], stop_frame=BOUT[1], **span) for f in files]
+                 ).to_csv(bouts, index=False)
+    args = ["prepare", "--tracking", str(track_dir), "--annotations", str(bouts), "--lab", LAB,
+            "--out", str(out / "ft_data"), "--pix-per-cm", "16", "--fps", "30"]
+    if reviewed:
+        rv = out / "reviewed.csv"
+        pd.DataFrame([dict(file=files[0], start_frame=a, stop_frame=b, **span) for a, b in REVIEWED]
+                     ).to_csv(rv, index=False)
+        args += ["--reviewed", str(rv)]
+    return _run(args), out / "ft_data", files
+
+
+def _load(data_dir, work_dir, monkeypatch):
+    from hidra import data
+    from hidra.torch.train_perlab import load_finetune_videos
+
+    monkeypatch.setenv("HIDRA_DATA_DIR", str(data_dir))
+    monkeypatch.setenv("PERLAB_WORKDIR", str(work_dir))
+    # load_finetune_videos repoints these module globals. Restore them after the test.
+    monkeypatch.setattr(data, "dataset_dir", data.dataset_dir)
+    monkeypatch.setattr(data, "working_dir", data.working_dir)
+    return load_finetune_videos()
+
+
+# ------------------------------------------------------------------ prepare
+
+def test_prepare_stages_reviewed_spans_and_clears_them_on_a_plain_rerun(track_dir, tmp_path):
+    log, d, files = _prepare(track_dir, tmp_path)
+    rdir = d / "train_reviewed" / LAB
+    staged = sorted(os.listdir(rdir))
+    assert len(staged) == len(files)            # one mask file per staged video
+    man = pd.read_csv(d / "TRAIN.csv")
+    assert all(f'"mouse2,mouse1,{ACTION}"' in b for b in man["behaviors_labeled"])
+    assert "reviewed frames (only these are trained on)" in log
+
+    # The trainer applies whatever masks it finds, so a plain re-prepare must remove them.
+    _prepare(track_dir, tmp_path, reviewed=False)
+    assert not rdir.exists()
+
+
+# ------------------------------------------------------------------ labels and windows
+
+def test_reviewed_mask_covers_spans_and_positive_bouts_only(track_dir, tmp_path, monkeypatch):
+    _, d, files = _prepare(track_dir, tmp_path)
+    videos = _load(d, tmp_path / "work", monkeypatch)
+    man = pd.read_csv(d / "TRAIN.csv")
+    by_file = dict(zip(man["video_id"], man["file"]))
+    for v in videos:
+        seen = v.labels.reviewed
+        assert seen is not None and seen.shape == (1, v.num_frames)
+        expect = np.zeros(v.num_frames, dtype=bool)
+        expect[BOUT[0]:BOUT[1]] = True            # a positive frame is reviewed by definition
+        if by_file[v.video_id] == files[0]:
+            for a, b in REVIEWED:
+                expect[a:b] = True
+        assert np.array_equal(seen[0], expect)
+
+
+def test_no_reviewed_flag_means_no_mask(track_dir, tmp_path, monkeypatch):
+    _, d, _ = _prepare(track_dir, tmp_path, reviewed=False)
+    assert all(v.labels.reviewed is None for v in _load(d, tmp_path / "work", monkeypatch))
+
+
+def test_windows_mark_exactly_the_unreviewed_frames(track_dir, tmp_path, monkeypatch):
+    from hidra import data, schema
+
+    _, d, _ = _prepare(track_dir, tmp_path)
+    videos = _load(d, tmp_path / "work", monkeypatch)
+    cfg = schema.get_configs()["15fps_5bp"]
+    ds = data.Dataset(videos=videos, seq_len=64, sample_rate=cfg["sample_rate"], padding=32,
+                      num_bodyparts=cfg["num_bodyparts"], num_epochs=1, unsupervised=False,
+                      num_workers=1, seed=[0])
+    keys = next(ds.epoch_generator())
+    checked = 0
+    for n, key in enumerate(keys[:200]):
+        v = ds.videos[int(key[0])]
+        cross = int(key[4])
+        if cross == -1:
+            continue
+        el = ds.get_element(key, {"element_idx": n, "epoch_idx": 0})
+        t0, t1 = float(key[5]), float(key[6])
+        mid, half = (t0 + t1) / 2, (t1 - t0) * ds.input_seq_len / ds.output_seq_len / 2
+        ts = np.linspace(mid - half, mid + half, ds.input_seq_len)[32:32 + ds.output_seq_len]
+        frames = ts * v.fps
+        seen = v.labels.reviewed[cross]
+        edges = np.flatnonzero(np.diff(seen.astype(int))) + 0.5
+        for f, lab in zip(frames, el["cross_labels"]):
+            if f < 0 or f > v.num_frames - 1 or (len(edges) and np.abs(edges - f).min() < 2):
+                continue                          # off the video, or too close to a span edge to call
+            assert (lab == -1) == (not seen[int(round(f))])
+            checked += 1
+    assert checked > 100
+
+
+# ------------------------------------------------------------------ loss
+
+def _random(seed=0, b=4, t=16, a=5):
+    g = torch.Generator().manual_seed(seed)
+    logits = torch.randn(b, t, a, generator=g)
+    labels = (torch.rand(b, t, a, generator=g) > 0.7).float()
+    mask = (torch.rand(b, a, generator=g) > 0.3).float()
+    return logits, labels, mask
+
+
+def test_loss_is_unchanged_when_every_frame_is_reviewed():
+    from hidra.torch.train import masked_bce
+
+    logits, labels, mask = _random()
+    plain, w0 = masked_bce(logits, labels, mask)
+    full, w1 = masked_bce(logits, labels, mask, mask[:, None].expand_as(labels).clone())
+    assert torch.allclose(plain, full, atol=1e-6) and float(w0) == float(w1)
+
+
+def test_unreviewed_frames_do_not_move_the_loss():
+    from hidra.torch.train import masked_bce
+
+    logits, labels, mask = _random(1)
+    frames = mask[:, None].expand_as(labels).clone()
+    frames[:, 8:] = 0
+    a, _ = masked_bce(logits, labels, mask, frames)
+    flipped, noisy = labels.clone(), logits.clone()
+    flipped[:, 8:] = 1 - flipped[:, 8:]
+    noisy[:, 8:] += 5.0
+    b, _ = masked_bce(noisy, flipped, mask, frames)
+    assert torch.equal(a, b)
+    first_half, _ = masked_bce(logits[:, :8], labels[:, :8], mask)
+    assert torch.allclose(a, first_half, atol=1e-6)
+
+
+def test_a_window_with_no_reviewed_frame_leaves_the_normalizer():
+    from hidra.torch.train import masked_bce
+
+    logits, labels, mask = _random(2)
+    frames = mask[:, None].expand_as(labels).clone()
+    frames[0] = 0
+    _, w = masked_bce(logits, labels, mask, frames)
+    assert float(w) == float(mask[1:].sum())
+
+
+def test_frame_mask_is_none_without_unreviewed_frames_and_zero_on_them():
+    from hidra.torch.train import frame_mask_in_action_space, labels_in_action_space
+
+    b, t, a, act = 2, 6, 5, 3
+    cross = torch.zeros(b, t, dtype=torch.int16)
+    cross[0, 2] = act
+    batch = {"self_labels": torch.zeros(b, t, dtype=torch.int16), "cross_labels": cross,
+             "self_label_mask": torch.zeros(b, a, dtype=torch.int8),
+             "cross_label_mask": torch.zeros(b, a, dtype=torch.int8),
+             "batch_mask": torch.ones(b, dtype=torch.int8)}
+    batch["cross_label_mask"][:, act] = 1
+    _, mask = labels_in_action_space(batch, a)
+    assert frame_mask_in_action_space(batch, mask) is None
+
+    batch["self_labels"][:] = -1                  # the unsupervised track, all unreviewed
+    batch["cross_labels"][1, 4:] = -1
+    labels, mask = labels_in_action_space(batch, a)   # must not choke on -1
+    fm = frame_mask_in_action_space(batch, mask)
+    assert fm.shape == (b, t, a)
+    assert fm[:, :, [0, 1, 2, 4]].sum() == 0      # unsupervised actions stay out
+    assert fm[0, :, act].tolist() == [1.0] * t
+    assert fm[1, :, act].tolist() == [1.0] * 4 + [0.0] * 2
+    assert labels[0, 2, act] == 1
+
+
+def test_cache_keeps_only_windows_with_a_reviewed_frame():
+    from hidra.torch.train import FeatureCache
+
+    n_a = 5
+    batch = {"self_labels": np.zeros((3, 4), np.int16), "cross_labels": np.zeros((3, 4), np.int16),
+             "self_label_mask": np.zeros((3, n_a), np.int8),
+             "cross_label_mask": np.zeros((3, n_a), np.int8)}
+    batch["cross_label_mask"][:, 3] = 1
+    assert FeatureCache._has_reviewed_frames(batch).all()     # no masks: keep everything
+    batch["self_labels"][:] = -1
+    batch["cross_labels"][0] = -1                             # nothing reviewed
+    batch["cross_labels"][1, :2] = -1                         # half reviewed
+    assert FeatureCache._has_reviewed_frames(batch).tolist() == [False, True, True]
